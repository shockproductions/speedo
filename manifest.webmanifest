{
  "name": "Speedo",
  "short_name": "Speedo",
  "description": "Motorsport telemetry: track, drift and drag timing with GNSS/IMU fusion.",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#120606",
  "theme_color": "#210907",
  "icons": [
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [
          ".speedo"
        ]
      }
    }
  ]
}
